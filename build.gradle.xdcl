nebulaGradlePlugin {
  description "Pluggable and configurable linter tool for identifying and reporting on patterns of misuse or deprecations in Gradle scripts"

  contacts [
    "nebula-plugins-oss@netflix.com": {
      moniker "Nebula Plugins Maintainers"
      github "nebula-plugins"
    },
  ]

  plugins [
    legacyNebulaLint: {
      id "nebula.lint"
      displayName "Nebula Lint plugin"
      description "Pluggable and configurable linter tool for identifying and reporting on patterns of misuse or deprecations in Gradle scripts"
      implementationClass "com.netflix.nebula.lint.plugin.GradleLintPlugin"
      tags ["nebula", "lint"]
    },
    nebulaLint: {
      id "com.netflix.nebula.lint"
      displayName "Nebula Lint plugin"
      description "Pluggable and configurable linter tool for identifying and reporting on patterns of misuse or deprecations in Gradle scripts"
      implementationClass "com.netflix.nebula.lint.plugin.GradleLintPlugin"
      tags ["nebula", "lint"]
    },
  ]

  dependencies {
    force ["org.eclipse.jgit:org.eclipse.jgit:5.0.1.201806211838-r"]

    shadow [
      "com.netflix.nebula:nebula-gradle-interop:latest.release",
      "org.apache.maven:maven-model-builder:3.8.3",
      "org.codehaus.gpars:gpars:1.2.1",
    ]

    bundled [
      "com.google.guava:guava:33.4.8-jre",
      {
        notation "org.ow2.asm:asm:9.+"
        reject ["7.2-beta"]
        because "avoid getting prerelease versions"
      },
      {
        notation "org.ow2.asm:asm-commons:9.+"
        reject ["7.2-beta"]
        because "avoid getting prerelease versions"
      },
      { notation "org.codenarc:CodeNarc:3.6.0-groovy-4.0", transitive false },
      "commons-lang:commons-lang:2.6",
      { notation "org.eclipse.jgit:org.eclipse.jgit:5.0.1.201806211838-r", transitive false },
      "org.eclipse.jdt:core:3.3.0-v_771",
    ]

    // These are because the AbstractRuleSpec test harness is included in src/main
    compileOnly [
      { notation "com.netflix.nebula:nebula-test:10.6.2", because "last version compiled on java 8" },
      "org.spockframework:spock-core:2.3-groovy-4.0",
      "junit:junit:4.13.2",
    ]
    compileOnlyGradleTestKit true

    testImplementation [
      "org.ow2.asm:asm-util:9.8",
      "joda-time:joda-time:latest.release",
      "com.netflix.nebula:gradle-info-plugin:latest.release",
      "org.spockframework:spock-core:2.3-groovy-4.0",
      "org.spockframework:spock-junit4:2.3-groovy-4.0",
    ]
  }

  // Relocate jgit dependency not available in Maven Central
  shading {
    include [
      "com.google.guava:guava",
      "org.eclipse.jdt:core",
      "org.eclipse.jgit:org.eclipse.jgit",
      "commons-lang:commons-lang",
      "org.codenarc:CodeNarc",
      "org.ow2.asm:asm",
      "org.ow2.asm:asm-commons",
    ]
    relocate [
      "com.google": "com.netflix.nebula.lint.com.google",
      "org.eclipse.jdt": "com.netflix.nebula.lint.jdt",
      "org.eclipse.jgit": "com.netflix.nebula.lint.jgit",
      "org.apache.commons.lang": "com.netflix.nebula.lint.commons.lang",
      "org.codenarc": "com.netflix.nebula.lint.org.codenarc",
      "org.objectweb.asm": "com.netflix.nebula.lint.org.objectweb.asm",
      "org.objectweb.asm.commons": "com.netflix.nebula.lint.org.objectweb.asm.commons",
      // powerassert is packed inside codenarc without relocation for some reason
      "org.codehaus.groovy.transform.powerassert": "com.netflix.nebula.lint.org.codehaus.groovy.transform.powerassert",
    ]
  }

  javaVersion 8
  testJavaVersion 17

  releaseBranchPatterns ["beta"]
}
